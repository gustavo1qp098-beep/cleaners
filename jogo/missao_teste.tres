id = "m1_seu_ze"
titulo = "Limpeza da Feira"
dialogo_inicio = "Opa, filho! O vento derrubou esse monte de folhagem podre na entrada da feira. Pode dar uma varrida rápida antes que os clientes cheguem?"
dialogo_fim = "Muito obrigado! Tomara que isso segure a poluição por hoje. Aqui estão suas 40 moedas."
